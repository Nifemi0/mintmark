{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "cpt1"
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "data/**/*.json"
    }
  },
  "rewrites": [
    {
      "source": "/registry",
      "destination": "/registry.html"
    },
    {
      "source": "/registry/",
      "destination": "/registry.html"
    },
    {
      "source": "/wallet",
      "destination": "/wallet.html"
    },
    {
      "source": "/wallet/",
      "destination": "/wallet.html"
    },
    {
      "source": "/method",
      "destination": "/method.html"
    },
    {
      "source": "/method/",
      "destination": "/method.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs.html"
    },
    {
      "source": "/reports",
      "destination": "/reports.html"
    },
    {
      "source": "/reports/",
      "destination": "/reports.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/v1",
      "destination": "/api/index"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ]
}
