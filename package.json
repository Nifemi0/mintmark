{
  "name": "mintmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node local.mjs",
    "sync": "node scripts/sync-ondo.mjs && node scripts/sync-providers.mjs",
    "sync:providers": "node scripts/sync-providers.mjs",
    "sync:logos": "node scripts/sync-logos.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
